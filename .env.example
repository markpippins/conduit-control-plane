# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CONDUIT_LIVE_MODE: Set to 'true' to proxy all API calls to real backends
# (conduit-mcp :3100 + conduit-srv :3104) instead of serving in-memory mock data.
# Default: false (mock mode).
CONDUIT_LIVE_MODE=false

# CONDUIT_MCP_URL: URL for conduit-mcp (pipeline state, kernel operations).
# Used only when CONDUIT_LIVE_MODE=true.
# CONDUIT_MCP_URL=http://localhost:3100

# CONDUIT_SRV_URL: URL for conduit-srv (workflows, tickets, tokens, governance, vision).
# Used only when CONDUIT_LIVE_MODE=true.
# CONDUIT_SRV_URL=http://localhost:3104
